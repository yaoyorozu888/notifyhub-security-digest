# サンプル（秘密情報はコミットしない）
# 実運用は Azure Functions / Key Vault / App Settings で注入する想定

# --- Digest Web URL ---
# メール内の (Web版) リンクのベースURL
DIGEST_BASE_URL=https://notifyhub.site/digest

# --- ACS Email ---
# ACS リソースの接続文字列
ACS_EMAIL_CONNECTION_STRING=Endpoint=https://<your-resource>.communication.azure.com/;AccessKey=<secret>
# 検証済みドメインの MailFrom
ACS_EMAIL_SENDER=notify@your-verified-domain.example
# 宛先（カンマ/セミコロン区切り可）
ACS_EMAIL_TO=you@example.com
# 任意: 件名プレフィックス
ACS_EMAIL_SUBJECT_PREFIX=NotifyHub CSIRT Daily Report

# --- Optional: OpenAI ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Optional: HTTP / logging ---
# NOTIFYHUB_HTTP_TIMEOUT=20
# NOTIFYHUB_HTTP_RETRIES=2
# LOG_LEVEL=INFO
